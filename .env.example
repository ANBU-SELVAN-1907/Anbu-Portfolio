# Copy to .env.local and use a Google AI Studio free-tier key.
# Never commit .env.local. Add the same secret through your production host.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Spark: public web configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_OWNER_UID=
# Private server secret. JSON stays on one line; retain escaped \n in private_key.
# Never commit the filled .env.local file or paste this credential into chat.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 private object storage (server only; never NEXT_PUBLIC_*)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=anbu-portfolio-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
